{
	"name": "zvonok-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "electron-dist/main.js",
	"scripts": {
		"test": "vitest run",
		"dev": "vite",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"build:web": "vite build --base=/",
		"build:electron": "tsc -p electron/tsconfig.json",
		"dev:desktop": "node scripts/electron-dev.mjs",
		"dev:desktop:hmr": "node scripts/electron-dev.mjs --hmr",
		"dev:desktop:watch": "node scripts/electron-dev.mjs --hmr --watch-main",
		"test:desktop:staging": "node scripts/electron-update-staging.cjs",
		"build:desktop-renderer": "npm run build:electron && node scripts/electron-renderer-build.mjs",
		"pack:desktop": "npm run build:desktop-renderer && electron-builder --dir --publish never",
		"pack:desktop:local": "npm run build:electron && node scripts/electron-renderer-build.mjs --local-docker && node scripts/electron-package-local.mjs",
		"test:desktop:local": "node scripts/electron-local-acceptance.cjs",
		"dist:desktop": "npm run build:desktop-renderer && electron-builder --publish never",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@livekit/components-react": "^2.9.20",
		"@livekit/krisp-noise-filter": "^0.3.4",
		"@reduxjs/toolkit": "^2.11.2",
		"@sapphi-red/web-noise-suppressor": "^0.3.5",
		"@stomp/stompjs": "^7.3.0",
		"@videojs/react": "10.1.0",
		"axios": "^1.13.2",
		"classnames": "^2.5.1",
		"electron-updater": "6.8.11",
		"livekit-client": "^2.17.2",
		"lucide-react": "^0.577.0",
		"pdfjs-dist": "^6.4.299",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.9.6",
		"sockjs-client": "^1.6.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"concurrently": "^10.0.3",
		"electron": "^43.0.0",
		"electron-builder": "^26.15.3",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"vitest": "^5.0.5",
		"wait-on": "^9.0.10"
	},
	"build": {
		"appId": "info.zvonok.desktop",
		"productName": "Zvonok",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron-dist/**/*",
			"electron/startup.html",
			"electron/startup.css",
			"electron/startup.js",
			"electron/dock.html",
			"electron/dock.css",
			"electron/dock.js",
			"assets/icons/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "assets/icons/icon.ico"
		},
		"nsis": {
			"installerIcon": "assets/icons/icon.ico",
			"uninstallerIcon": "assets/icons/icon.ico",
			"uninstallDisplayName": "Zvonok",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
