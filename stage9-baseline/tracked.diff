-			left: videoRect.left - rootRect.left,
-			top: videoRect.top - rootRect.top,
-			width: videoRect.width,
-			height: videoRect.height,
-		};
-	}
-
-	const videoRatio = intrinsicWidth / intrinsicHeight;
