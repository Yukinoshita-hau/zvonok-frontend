{
	"name": "zvonok-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "electron-dist/main.js",
	"scripts": {
		"dev": "vite",
		"dev:web": "vite",
		"build": "tsc -b && vite build",
		"build:web": "vite build --base=/",
		"build:electron": "tsc -p electron/tsconfig.json",
		"dev:desktop": "concurrently -k \"npm:dev:web\" \"wait-on http://localhost:3000 && npm run build:electron && electron .\"",
		"dist:desktop": "vite build --base=./ && npm run build:electron && electron-builder",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@livekit/components-react": "^2.9.20",
		"@livekit/krisp-noise-filter": "^0.3.4",
		"@monaco-editor/react": "^4.7.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@sapphi-red/web-noise-suppressor": "^0.3.5",
		"@stomp/stompjs": "^7.3.0",
		"axios": "^1.13.2",
		"classnames": "^2.5.1",
		"livekit-client": "^2.17.2",
		"lucide-react": "^0.577.0",
		"monaco-editor": "^0.53.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.9.6",
		"sockjs-client": "^1.6.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"concurrently": "^10.0.3",
		"electron": "^43.0.0",
		"electron-builder": "^26.15.3",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"wait-on": "^9.0.10"
	},
	"build": {
		"appId": "info.zvonok.desktop",
		"productName": "Zvonok",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron-dist/**/*",
			"assets/icons/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "assets/icons/icon.ico"
		},
		"nsis": {
			"installerIcon": "assets/icons/icon.ico",
			"uninstallerIcon": "assets/icons/icon.ico",
			"uninstallDisplayName": "Zvonok",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
